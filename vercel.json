{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/california-training",
      "destination": "/training/california",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/training/illinois",
      "destination": "/training/coming-soon.html?state=illinois"
    },
    {
      "source": "/training/connecticut",
      "destination": "/training/coming-soon.html?state=connecticut"
    },
    {
      "source": "/training/delaware",
      "destination": "/training/coming-soon.html?state=delaware"
    },
    {
      "source": "/training/maine",
      "destination": "/training/coming-soon.html?state=maine"
    }
  ],
  "headers": [
    {
      "source": "/sandbox/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/threads-landing.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/threads-landing.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
